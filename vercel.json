

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "apms-backend": {
      "root": "apms-backend",
      "framework": "express"
    },
    "apms-frontend": {
      "root": "apms-frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "apms-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "apms-frontend"
      }
    }
  ]
}
